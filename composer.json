{
  "name": "nrgi/resourcecontracts-admin",
  "description": "ResourceContracts.org admin application (rc-admin).",
  "keywords": [
    "framework",
    "laravel",
    "nrgi"
  ],
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "laravel/framework": "^13.0",
    "laravel/helpers": "^1.8",
    "laravel/ui": "^4.6",
    "gghughunishvili/entrust": "^13.0",
    "rap2hpoutre/laravel-log-viewer": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "pda/pheanstalk": "^7.0 || ^8.0",
    "guzzlehttp/guzzle": "^7.5",
    "phpoffice/phpword": "^1.4",
    "maatwebsite/excel": "^3.1.70"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0",
    "mockery/mockery": "^1.4",
    "fakerphp/faker": "^1.9",
    "barryvdh/laravel-ide-helper": "^3.7",
    "barryvdh/laravel-debugbar": "^4.4",
    "spatie/laravel-ignition": "^2.12",
    "larastan/larastan": "^3.13",
    "nunomaduro/collision": "^8.9"
  },
  "autoload": {
    "classmap": [
      "database/migrations"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/Nrgi/helper.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "kylekatarnls/update-helper": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
